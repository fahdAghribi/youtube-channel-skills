# Copy to .env (never commit .env). Shell variables override these values.

# Tier 1: public research (outliers, competitor stats).
# Google Cloud console > APIs & Services > Credentials > Create API key.
# Restrict it to "YouTube Data API v3".
YT_API_KEY=

# Tier 2: owner mode (upload, schedule, edit, comments, analytics).
# OAuth client of type "Desktop app"; download the JSON and point to it.
# Enable "YouTube Data API v3" and "YouTube Analytics API" in the same project.
YT_CLIENT_SECRETS=/absolute/path/to/client_secret.json

# Optional: where the OAuth token is stored (default ~/.config/youtube-channel-skills)
# YT_SKILLS_CONFIG_DIR=
